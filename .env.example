# Copy file này thành ".env" rồi điền giá trị thật vào. Không commit ".env" lên git.

# --- Google Drive ---
# (Không cần khai báo credentials ở đây nữa — dùng OAuth qua file
#  oauth_client.json + token.json tự sinh, xem README.md)

# ID của folder Drive để lưu kịch bản (đã duyệt, lấy trực tiếp từ Claude chat)
# Lấy từ URL folder: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_FOLDER_ID=

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY_DEFAULT=CONTENT
JIRA_ISSUE_TYPE=Task

# --- Phân loại kịch bản theo tiêu đề ---
# Tiêu đề chứa cụm từ này (không phân biệt hoa/thường) → nhóm "Lore"
CATEGORY_LORE_KEYWORD=your life as every
# Nhóm "Lore": folder Drive + cột Jira tương ứng
DRIVE_FOLDER_LORE_NAME=Lore & Disorder
JIRA_STATUS_LORE=Law & Disorder
# Nhóm còn lại ("Lowkey"): folder Drive + cột Jira tương ứng
DRIVE_FOLDER_LOWKEY_NAME=Lowkey Explainer
JIRA_STATUS_LOWKEY=Lowkey Explainer
