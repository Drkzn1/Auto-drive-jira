# Copy file này thành ".env" rồi điền giá trị thật vào. Không commit ".env" lên git.

# --- Google Drive ---
# (Không cần khai báo credentials ở đây nữa — dùng OAuth qua file
#  oauth_client.json + token.json tự sinh, xem README.md)

# Các folder có sẵn trên Drive — script CHỈ upload vào đúng các folder này,
# không tự tạo folder mới nào khác. Lấy ID từ URL folder:
# drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_FOLDER_ID_LORE=
DRIVE_FOLDER_ID_STARWARS=
DRIVE_FOLDER_ID_FALLOUT=
DRIVE_FOLDER_ID_LOWKEY=

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY_DEFAULT=CONTENT
JIRA_ISSUE_TYPE=Task

# --- Phân loại kịch bản (khớp lần lượt theo thứ tự, cái nào trước dùng cái
# đó; soi cả tiêu đề lẫn nội dung — bắt được cả hashtag ở cuối kịch bản) ---
CATEGORY_LORE_KEYWORD=your life as every
JIRA_STATUS_LORE=Law & Disorder
CATEGORY_STARWARS_KEYWORD=star wars
JIRA_STATUS_STARWARS=POV Life
CATEGORY_FALLOUT_KEYWORD=fallout
JIRA_STATUS_FALLOUT=Hidden Game Theory
# Tiêu đề BẮT ĐẦU bằng cụm này (không soi nội dung, tránh false-positive như
# "however"/"show") -> Lowkey. Đích đến giống hệt nhóm mặc định bên dưới.
CATEGORY_HOWTO_PREFIX=how
# Nhóm mặc định khi không khớp từ khoá/prefix nào ở trên
JIRA_STATUS_LOWKEY=Lowkey Explainer
